@prefix ex: <http://example.org/> .


ex:PumpMaintenanceProcedure rdf:type <https://www.commoncoreontologies.org/ont00000965> .

#Technician Alex performs Inspection 17 on Pump P-17.
ex:Alex rdf:type <https://www.commoncoreontologies.org/ont00001262> .
ex:PumpP17 rdf:type <https://www.commoncoreontologies.org/ont00000116> .
ex:Inspection17 rdf:type <http://purl.obolibrary.org/obo/BFO_0000015> .
ex:Alex <http://purl.obolibrary.org/obo/BFO_0000056> ex:Inspection17 .
ex:PumpP17 <http://purl.obolibrary.org/obo/BFO_0000056> ex:Inspection17 .
#The inspection produces Report R-17. .
ex:ReportR17 <https://www.commoncoreontologies.org/ont00001816> ex:Inspection17 .
#The report records a vibration measurement of 4.2 mm/s and states that the pump requires bearing replacement.
ex:ReportMeasurent rdf:type <https://www.commoncoreontologies.org/ont00001163> .
ex:ReportMeasurement <https://www.commoncoreontologies.org/ont00001863> <https://www.commoncoreontologies.org/ont00001511> .
ex:ReportMeasurement <https://www.commoncoreontologies.org/ont00001769> "0.0042"^^xsd:decimal .


